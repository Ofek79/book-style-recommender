# Settings for the production build (npm run build), deployed to Firebase
# Hosting. Vite loads this file only for builds - `npm run dev` keeps using
# frontend/.env, so local development is unaffected.
#
# These values are baked into the built files at build time: changing
# one means building again. Nothing here is secret - everything in a
# frontend build is readable by anyone who opens the site.

# The deployed backend on Cloud Run (see DECISIONS.md). No trailing
# slash: the code adds it (e.g. `${API_URL}/books`).
VITE_API_URL=https://book-a-like-api-870137644140.me-west1.run.app

# The public site is read-only: hides the tagging tab and the rating form.
# The backend's own READ_ONLY setting is what actually refuses writes.
VITE_READ_ONLY=true
