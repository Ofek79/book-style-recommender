# Example environment file for the backend and database.
# Copy it to .env and fill in real values. The .env file itself is not committed.
#
# The frontend has its own separate .env in frontend/ - it never sees these values.

# --- Database (Postgres) ---
# These three are used both by docker-compose to initialize the database
# and by the server to connect to it.
POSTGRES_USER=book_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=book_style

# Full connection string the server (FastAPI) uses.
# host=localhost when running the server outside Docker; port 5432 is exposed by docker-compose.
DATABASE_URL=postgresql://book_user:change_me@localhost:5432/book_style

# --- LLM auto-tagging (backend/llm_tagging.py and the scripts that use it) ---
# Get a key at https://aistudio.google.com/apikey. Used only by the
# terminal scripts (tag_with_llm.py, add_books_bulk.py,
# compare_llm_tagging.py) - the API server itself never calls Gemini.
GEMINI_API_KEY=change_me

# --- Deployment settings (leave commented out for local development) ---
# Frontend origins allowed to call the API from a browser, comma-separated.
# Unset, it defaults to the local Vite dev server (http://localhost:5173).
# In production, set it to the Firebase Hosting address.
# CORS_ALLOWED_ORIGINS=https://your-project.web.app

# Set to true on the public deployment: every write endpoint (add book,
# tag, rate) then returns 403. Unset or anything else means writes work,
# as they should locally. See DECISIONS.md.
# READ_ONLY=true
