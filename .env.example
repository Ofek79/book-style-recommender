# Example environment file for the backend and database.
# Copy it to .env and fill in real values. The .env file itself is not committed.
#
# The frontend has its own separate .env in frontend/ - it never sees these values.

# --- Database (Postgres) ---
# These three are used both by docker-compose to initialize the database
# and by the server to connect to it.
POSTGRES_USER=book_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=book_style

# Full connection string the server (FastAPI) uses.
# host=localhost when running the server outside Docker; port 5432 is exposed by docker-compose.
DATABASE_URL=postgresql://book_user:change_me@localhost:5432/book_style
